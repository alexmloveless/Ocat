# API Keys - Required for LLM functionality
# Get these from your respective providers
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GOOGLE_API_KEY=your_google_api_key_here

# Ocat Configuration Overrides (Optional)
# These will override settings in config files

# Model Configuration
# OCAT_MODEL=gpt-4o-mini
# OCAT_TEMPERATURE=1.0
# OCAT_MAX_TOKENS=4000

# Vector Store Configuration
# OCAT_VECTOR_STORE_PATH=/app/vector_stores/default
# OCAT_VECTOR_STORE_ENABLED=true

# Logging Configuration
# OCAT_LOG_LEVEL=WARN

# Profile Configuration
# OCAT_PROFILE_NAME=default

# Advanced Settings (usually not needed)
# ANONYMIZED_TELEMETRY=False
# TOKENIZERS_PARALLELISM=false
